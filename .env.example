# ---------- API ----------
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobagent
REDIS_URL=
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:3000
STORAGE_DIR=./uploads
# Optional LLM (rule-based matching works without it)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------- WEB ----------
# Server-side rewrite target (Railway private network in production)
INTERNAL_API_URL=http://localhost:3001
# Browser-side API base (used only for the live agent WebSocket)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------- RUNNER ----------
RUNNER_API_URL=http://localhost:3001
RUNNER_EMAIL=you@example.com
RUNNER_PASSWORD=your-password
RUNNER_PROFILE_DIR=./browser-profile
RUNNER_CV_DIR=./cv
RUNNER_HEADLESS=false
ALLOWED_DOMAINS=linkedin.com,jobstreet.co.id,glints.com,indeed.com
